# Copy to .env only if you need to change the defaults.

# Frontend: leave empty to use the same address (recommended). Set it only if the
# API is hosted somewhere else, e.g. https://my-api.onrender.com
VITE_API_URL=

# Frontend dev server: where Vite forwards /api calls.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Backend (set in your shell, not read from .env):
#   SPACESAGE_MODEL=/path/to/best.pt   use a different YOLO weights file
#   CORS_ORIGINS=https://my-site.com   restrict browsers allowed to call the API (default: any)
#   PORT=8000                          backend port
